# ========================================
# EBookFarm Backend - Environment Variables
# ========================================
# Hướng dẫn: Copy file này thành .env rồi điền đúng các giá trị

# ---- SERVER ----
PORT=5000
NODE_ENV=development

# ---- MONGODB ATLAS ----
# Lấy từ: https://cloud.mongodb.com → Cluster → Connect → Drivers
# Định dạng: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/ebookfarm?retryWrites=true&w=majority

# ---- JWT ----
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRE=7d

# ---- GOOGLE OAUTH ----
# Lấy từ: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=147676468818-86oa6l06us45c8as6272v1mbc6egenf5.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ---- CLOUDINARY (lưu trữ ảnh) ----
# Lấy từ: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- EMAIL (Nodemailer - dùng Gmail) ----
# Bật "App Password" trong Google Account: myaccount.google.com/apppasswords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# ---- GROQ AI ----
# Lấy từ: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- GOOGLE GEMINI AI ----
# Lấy từ: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- OPENAI ----
# Lấy từ: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- FRONTEND URL (CORS) ----
CLIENT_URL=http://localhost:5173
